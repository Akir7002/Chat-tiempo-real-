# Puerto del Servidor HTTP
PORT=3000

# ==========================================
# CONFIGURACIÓN DE FIREBASE ADMIN (Backend)
# ==========================================
GOOGLE_APPLICATION_CREDENTIALS="./serviceAccountKey.json"

# ==========================================
# CONFIGURACIÓN DE MONGODB ATLAS (Base de datos de películas)
# ==========================================
# Reemplaza con tu cadena de conexión real de MongoDB Atlas:
# Ejemplo: mongodb+srv://usuario:password@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://USUARIO:CLAVE@CLUSTER/?retryWrites=true&w=majority"
MONGODB_DB="sample_mflix"

# ==========================================
# CONFIGURACIÓN DE MODELOS LOCALES OLLAMA
# ==========================================
# Servidor local de Ollama (por defecto: http://127.0.0.1:11434)
OLLAMA_HOST="http://127.0.0.1:11434"

# Modelo LLM para interpretar consultas y chatear (CineBot):
OLLAMA_MODEL_CHAT="qwen2.5:3b"

# Modelo de Embeddings para búsqueda semántica vectorial:
OLLAMA_MODEL_EMBED="nomic-embed-text"
